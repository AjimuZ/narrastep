{
  "name": "@narrastep/web",
  "version": "0.2.0",
  "private": true,
  "description": "Narrastep local-first review application",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "build": "node scripts/check-i18n.mjs && ng build --configuration production",
    "check:i18n": "node scripts/check-i18n.mjs --extract",
    "extract-i18n": "node scripts/check-i18n.mjs write",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "e2e:fullstack": "playwright test --config=playwright.fullstack.config.ts",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/animations": "22.0.6",
    "@angular/cdk": "22.0.4",
    "@angular/common": "22.0.6",
    "@angular/compiler": "22.0.6",
    "@angular/core": "22.0.6",
    "@angular/forms": "22.0.6",
    "@angular/localize": "22.0.6",
    "@angular/platform-browser": "22.0.6",
    "@angular/platform-browser-dynamic": "22.0.6",
    "@angular/router": "22.0.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular/build": "22.0.6",
    "@angular/cli": "22.0.6",
    "@angular/compiler-cli": "22.0.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.0.0",
    "angular-eslint": "22.0.0",
    "eslint": "10.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.0.8"
  }
}
