# Settings of the isolated stack (stack.sh). Other ports than the owner's stack, so both can run,
# and the small model, which is what CI builds too. Not secret, and never the owner's .env.
NARRASTEP_API_PORT=18002
NARRASTEP_WEB_PORT=14200
NARRASTEP_CORS_ORIGINS=http://127.0.0.1:14200
NARRASTEP_WHISPER_MODEL=tiny
