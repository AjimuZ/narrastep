NARRASTEP_ENV=development
NARRASTEP_HOST=127.0.0.1
NARRASTEP_API_PORT=8002
NARRASTEP_WEB_PORT=4200

NARRASTEP_DATA_DIR=/data
NARRASTEP_DATABASE_URL=sqlite:////data/narrastep.db

NARRASTEP_REDIS_URL=redis://redis:6379/0
NARRASTEP_CELERY_BROKER_URL=redis://redis:6379/0
NARRASTEP_CELERY_RESULT_BACKEND=redis://redis:6379/1
NARRASTEP_JOB_VISIBILITY_TIMEOUT_SECONDS=86400
NARRASTEP_JOB_STALE_AFTER_SECONDS=300

NARRASTEP_MAX_UPLOAD_SIZE_MB=4096
NARRASTEP_UPLOAD_CHUNK_BYTES=1048576
NARRASTEP_MIN_FREE_DISK_MB=1024
NARRASTEP_ALLOWED_VIDEO_EXTENSIONS=mp4,webm,mov,mkv
NARRASTEP_FFMPEG_PATH=ffmpeg
NARRASTEP_FFPROBE_PATH=ffprobe
NARRASTEP_MEDIA_COMMAND_TIMEOUT_SECONDS=120

NARRASTEP_WHISPER_MODEL=small
NARRASTEP_WHISPER_MODEL_PATH=/opt/models/small
NARRASTEP_WHISPER_DEVICE=cpu
NARRASTEP_WHISPER_COMPUTE_TYPE=int8
NARRASTEP_WHISPER_LOCAL_FILES_ONLY=true
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1

NARRASTEP_FRAME_INTERVAL_SECONDS=3
NARRASTEP_FRAME_DUPLICATE_THRESHOLD=0.92
NARRASTEP_SCREENSHOT_ALTERNATIVES_PER_SEGMENT=2
NARRASTEP_SCREENSHOT_SELECTION_STRATEGY=legacy
NARRASTEP_OCR_MODE=selective
NARRASTEP_IMAGE_BUDGET_PROFILE=balanced
NARRASTEP_TESSERACT_PATH=tesseract
NARRASTEP_CHATGPT_MAX_FILES_PER_BATCH=20
NARRASTEP_STABILITY_SAMPLE_OFFSET_SECONDS=0.2
NARRASTEP_SSE_HEARTBEAT_SECONDS=15
NARRASTEP_SSE_POLL_SECONDS=0.5

NARRASTEP_ENABLE_MOCK_PROCESSING=false
NARRASTEP_LOG_LEVEL=INFO
NARRASTEP_CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
